{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checklist",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tasks.cadenchau.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": { "command": "npm run build" },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ACCESS_ALLOWED_EMAIL": ""
  }
}
